# Production environment for infra/compose.prod.yaml
# Copy to .env.production and fill in real values. Never commit the filled file.

# Public hostname served by Caddy (TLS is automatic).
APP_DOMAIN=incident.purecode.sh

# Exact application origin. Must match APP_DOMAIN with https.
APP_ORIGIN=https://incident.purecode.sh

# Database. The password is used to initialize PostgreSQL; keep it out of version control.
POSTGRES_PASSWORD=change-me-to-a-long-random-value
DATABASE_URL=postgres://incident_dev:change-me-to-a-long-random-value@db:5432/incident_commander

# Interpretation provider: openrouter | disabled
AI_PROVIDER=disabled
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DECISIONS_URL=https://openrouter.ai/api/alpha/decisions
OPENROUTER_MODEL_ID=typesafe/jev-1.13
OPENROUTER_APP_TITLE=Incident Commander
INTERPRETER_TIMEOUT_MS=8000
INTERPRETER_PROMPT_VERSION=ic-commands-1

LOG_LEVEL=info
