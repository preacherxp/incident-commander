# Backend-only PostgreSQL connection string.
# From the host process (bun run dev) use localhost; inside Compose use db.
DATABASE_URL=postgres://incident_dev:change-me@localhost:5432/incident_commander

# Local Compose initialization secret. Keep out of version control.
POSTGRES_PASSWORD=change-me

# API port.
PORT=3000

# Exact application origin used for the ownership cookie and mutation-origin policy.
APP_ORIGIN=http://localhost:5173

# Jev's voice provider: openrouter | disabled.
# Disabled keeps the game fully playable with deterministic canned lines.
AI_PROVIDER=disabled

# Backend-only OpenRouter credential (required when AI_PROVIDER=openrouter).
# OPENCODE_API_KEY is accepted as an alias for local convenience.
OPENROUTER_API_KEY=

# OpenRouter chat-completions endpoint used for Jev's dialogue.
OPENROUTER_CHAT_URL=https://openrouter.ai/api/v1/chat/completions

# Pinned chat model for Jev's lines.
OPENROUTER_VOICE_MODEL_ID=openai/gpt-4o-mini

# Optional OpenRouter attribution headers.
OPENROUTER_SITE_URL=
OPENROUTER_APP_TITLE=Incident Commander

# Jev dialogue request deadline in milliseconds.
VOICE_TIMEOUT_MS=8000

# Immutable prompt version recorded with every line.
VOICE_PROMPT_VERSION=ic-jev-voice-1

# Operational logging level: debug | info | warn | error
LOG_LEVEL=info
