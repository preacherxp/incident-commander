# Backend-only PostgreSQL connection string.
# From the host process (bun run dev) use localhost; inside Compose use db.
DATABASE_URL=postgres://incident_dev:change-me@localhost:5432/incident_commander

# Local Compose initialization secret. Keep out of version control.
POSTGRES_PASSWORD=change-me

# API port.
PORT=3000

# Exact application origin used for the ownership cookie and mutation-origin policy.
APP_ORIGIN=http://localhost:5173

# Interpretation provider: openrouter | disabled
AI_PROVIDER=disabled

# Backend-only OpenRouter credential (required when AI_PROVIDER=openrouter).
# OPENCODE_API_KEY is accepted as an alias for local convenience.
OPENROUTER_API_KEY=

# OpenRouter OpenAI-compatible base URL (reserved for future chat adapters).
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OpenRouter Decisions endpoint used by the Jev adapter (required for Jev).
OPENROUTER_DECISIONS_URL=https://openrouter.ai/api/alpha/decisions

# Pinned OpenRouter model identifier.
OPENROUTER_MODEL_ID=typesafe/jev-1.13

# Optional OpenRouter attribution headers.
OPENROUTER_SITE_URL=
OPENROUTER_APP_TITLE=Incident Commander

# Overall interpretation request deadline in milliseconds.
INTERPRETER_TIMEOUT_MS=8000

# Immutable rubric version.
INTERPRETER_PROMPT_VERSION=ic-commands-1

# Operational logging level: debug | info | warn | error
LOG_LEVEL=info
